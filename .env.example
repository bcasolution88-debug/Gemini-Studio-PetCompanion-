# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public base URL of the deployed applet (e.g. https://pet.example.com).
# Optional. Read by the server for absolute links / CORS hints. When unset the
# app derives its origin from the incoming request.
APP_URL="MY_APP_URL"

# PORT: Port to bind. Platforms such as Railway / Render / Fly / Cloud Run
# inject this automatically; defaults to 3000 when absent.
PORT="3000"

# AUTH_MODE: API authentication policy for /api/* routes.
#   optional (default) - identify the caller when a Firebase ID token is sent,
#                        but still allow anonymous traffic (rate limited).
#   required           - reject anonymous calls with 401. Set this before
#                        exposing the app publicly so the paid AI endpoints
#                        cannot be used by anyone who finds the URL.
AUTH_MODE="optional"

# FIREBASE_PROJECT_ID: Firebase project used to validate ID token `aud` / `iss`.
# Defaults to the project id in firebase-applet-config.json.
FIREBASE_PROJECT_ID="clean-xyston-v18qq"
