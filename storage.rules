rules_version = '2';

// Firebase Storage security rules for the Pet Companion Platform.
//
// Layout:
//   pets/{uid}/{file}          - pet photos, owner-only writes, public read
//   avatars/{uid}/{file}       - user avatars, owner-only writes, public read
//   private/{uid}/{file}       - medical / journal photos, owner-only read+write
//
// Deploy with:  firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function underMegabytes(mb) {
      return request.resource.size < mb * 1024 * 1024;
    }

    // Public pet photos (appear in the adoption catalogue).
    match /pets/{uid}/{fileName} {
      allow read: if true;
      allow write: if isOwner(uid) && isImage() && underMegabytes(10);
      allow delete: if isOwner(uid);
    }

    // Public avatars.
    match /avatars/{uid}/{fileName} {
      allow read: if true;
      allow write: if isOwner(uid) && isImage() && underMegabytes(5);
      allow delete: if isOwner(uid);
    }

    // Private medical imagery - never publicly readable.
    match /private/{uid}/{fileName} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && isImage() && underMegabytes(15);
      allow delete: if isOwner(uid);
    }

    // Deny anything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
